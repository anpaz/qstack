// QSTACKQASM 0.1 — qstack surface language (lark grammar).
//
// QSTACKQASM borrows OpenQASM 3's syntax and shares its file extension
// (.qasm) so editor highlighting carries over, but it is not a subset of
// OpenQASM 3 and is not compatible with OpenQASM 3 toolchains. Beyond its own
// header, the only new syntax is the `selector` modifier on `extern`.
// QSTACKQASM also lifts one OpenQASM scope rule: qubits can be declared
// inside a `def` and in any block.
//
// Covers:
//   - QSTACKQASM header, include
//   - extern (decoder) and extern selector declarations
//   - def with qubit / bit declarations, gate application, def call,
//     measure, decoder call, switch, while, for
//   - the same statements at the top level

start: header include* decl* stmt*

header: "QSTACKQASM" NUMBER ";"
include: "include" STRING ";"

?decl: extern_decl
     | selector_decl
     | def_decl

extern_decl: "extern" IDENT "(" type_list ")" "->" type ";"
selector_decl: "extern" "selector" IDENT "(" type_list ")" "->" type ";"

def_decl: "def" IDENT "(" param_list? ")" return_type? block

return_type: "->" type
param_list: param ("," param)*
param: type IDENT

type: "qubit"    -> qubit_type
    | "bit"     -> bit_type
    | "int"     -> int_type
type_list: (type ("," type)*)?

block: "{" stmt* "}"

?stmt: qubit_stmt
     | bit_stmt
     | apply_stmt
     | call_stmt
     | measure_stmt
     | decode_stmt
     | switch_stmt
     | while_stmt
     | for_stmt

// declarations:  qubit q;   qubit[3] a;   bit m;   bit[3] c;
// a block's qubits are local to it
qubit_stmt: "qubit" designator? IDENT ";"
bit_stmt:   "bit" designator? IDENT ";"
designator: "[" NUMBER "]"

// gate application:  h q;     cx q, ancilla[0];
// Parametric gates carry a parenthesised list of numeric arguments:
//   skew(0.8) q;
apply_stmt: IDENT gate_params? qubit_arg ("," qubit_arg)* ";"
gate_params: "(" gate_param ("," gate_param)* ")"
gate_param: SIGNED_NUMBER

// def call:  prepare_one(q);     teleport(a[0], b);
call_stmt: IDENT "(" (qubit_arg ("," qubit_arg)*)? ")" ";"

// measurement:  measure q[0] -> c[0];   |   measure ancilla[0] -> m;
measure_stmt: "measure" qubit_arg "->" bit_target ";"

// decoder call, OpenQASM's extern-call syntax:
//   bit b = majority(m0, m1, m2);   |   b = majority(m0, m1, m2);
decode_stmt: "bit" IDENT "=" callback_call ";"    -> decode_decl
           | bit_target "=" callback_call ";"     -> decode_assign

// switch (selector(b1, b2, ...)) { case 0 { ... } case 1 { ... } }
// the selector is declared `-> int`
switch_stmt: "switch" "(" callback_call ")" "{" case_arm+ "}"
case_arm: "case" NUMBER block

// while (selector(b1, ...)) { ... }: the selector is declared `-> int`, as for
// a switch; its label is 1 to run the body again and 0 to stop.  The body
// measures every bit the condition reads.
while_stmt: "while" "(" callback_call ")" block

// for int i in [a:b] / [a:c:b] (start, step, stop; inclusive) / {v, ...}:
// compile-time bounds, unrolled.
for_stmt: "for" loop_type IDENT "in" loop_values block
loop_type: ("int" | "uint") ("[" NUMBER "]")?
?loop_values: "[" NUMBER ":" NUMBER "]"                -> range2
            | "[" NUMBER ":" NUMBER ":" NUMBER "]"     -> range3
            | "{" NUMBER ("," NUMBER)* "}"             -> value_set

callback_call: IDENT "(" bit_args? ")"
bit_args: bit_target ("," bit_target)*

// argument shapes; an index is a constant or a for-loop variable
?qubit_arg: IDENT                          -> qubit_ref
          | IDENT "[" index "]"            -> qubit_index
?bit_target: IDENT                         -> bit_ref
           | IDENT "[" index "]"           -> bit_index
index: NUMBER | IDENT

IDENT: /[A-Za-z_][A-Za-z0-9_]*/
NUMBER: /[0-9]+(\.[0-9]+)?/
SIGNED_NUMBER: /[+-]?[0-9]+(\.[0-9]+)?/
STRING: /"[^"]*"/

COMMENT: /\/\/[^\n]*/
ML_COMMENT: /\/\*([^*]|\*(?!\/))*\*\//

%ignore /[ \t\r\n]+/
%ignore COMMENT
%ignore ML_COMMENT
